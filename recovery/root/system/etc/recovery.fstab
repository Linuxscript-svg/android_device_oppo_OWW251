# OPPO Watch X2 (OWW251) - fs_mgr 格式 fstab
#
# 这个文件是 init / fastbootd 用的（安装为 /system/etc/recovery.fstab）。
# TWRP 自己的挂载表在同一个目录的 twrp.fstab（TWRP 优先读 /etc/twrp.fstab）。
#
# 与原厂 recovery.fstab 的差异：
#   * 去掉不存在的 odm 分区（真机 super 元数据里只有 system/system_ext/vendor/product）
#   * metadata 用 /dev/block/bootdevice/by-name，和原厂一致
#   * data 的 fileencryption 标志保持原厂值，否则 fastbootd 会把它当未加密分区擦除

#<src>                                                  <mnt_point>     <type>  <mnt_flags>                                                     <fs_mgr_flags>
system                                                  /system         ext4    ro,barrier=1,discard                                            wait,logical,first_stage_mount
system_ext                                              /system_ext     ext4    ro,barrier=1,discard                                            wait,logical,first_stage_mount
vendor                                                  /vendor         ext4    ro,barrier=1,discard                                            wait,logical,first_stage_mount
product                                                 /product        ext4    ro,barrier=1,discard                                            wait,logical,first_stage_mount
/dev/block/bootdevice/by-name/cache                     /cache          ext4    nosuid,noatime,nodev,barrier=1                                   wait,check
/dev/block/bootdevice/by-name/metadata                  /metadata       ext4    noatime,nosuid,nodev,discard                                     wait,check,formattable,wrappedkey
/dev/block/bootdevice/by-name/userdata                  /data           f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt latemount,wait,check,formattable,quota,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized+wrappedkey_v0,checkpoint=fs
/dev/block/bootdevice/by-name/persist                   /mnt/vendor/persist ext4 noatime,nosuid,nodev,barrier=1                                  wait
/dev/block/bootdevice/by-name/misc                      /misc           emmc    defaults                                                        defaults
/dev/block/bootdevice/by-name/boot                      /boot           emmc    defaults                                                        defaults
/dev/block/bootdevice/by-name/recovery                  /recovery       emmc    defaults                                                        defaults
