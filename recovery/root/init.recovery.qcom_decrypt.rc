# OPPO Watch X2 (OWW251) - /data 解密所需的 vendor HAL
#
# 本机 /data 是 FBE v2 + metadata 加密（dm-default-key）+ wrappedkey_v0，
# 密钥由 TEE 里的 keymaster 4.1 解封，所以 TWRP 里必须把 vendor 的
# keymaster / gatekeeper 服务跑起来：
#   recovery/root/system/bin/android.hardware.keymaster@4.1-service-qti
#   recovery/root/system/bin/android.hardware.keymaster@4.0-service-qti
#   recovery/root/system/bin/android.hardware.gatekeeper@1.0-service-qti
# 依赖库放在 recovery/root/system/lib（recovery 的 ld.config.txt 只搜 /system/lib）。
#
# 如果 TWRP 的 crypto 编译已经自带了 servicemanager / hwservicemanager 的服务定义，
# init 会把这里的重复定义当作 duplicate 忽略（保留先解析到的那份），不会启动失败。

on fs
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0666 /dev/ion
    chown system system /dev/ion

# HIDL 基础服务：没有 hwservicemanager，keymaster 注册不上，
# TWRP 的 decrypt 页面会一直停在 "Unable to decrypt"
service servicemanager /system/bin/servicemanager
    class core
    user system
    group system readproc
    seclabel u:r:recovery:s0
    disabled

service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    seclabel u:r:recovery:s0
    disabled

service vndservicemanager /system/bin/vndservicemanager /dev/vndbinder
    class core
    user system
    group system readproc
    seclabel u:r:recovery:s0
    disabled

on fs
    start servicemanager
    start vndservicemanager
    start hwservicemanager

# keymaster / gatekeeper 必须等 hwservicemanager 就绪
on property:hwservicemanager.ready=true
    start vendor.keymaster-4-1-qti
    start vendor.gatekeeper-1-0-qti

# keymaster 4.1 -> TEE（QSEECom）
service vendor.keymaster-4-1-qti /system/bin/android.hardware.keymaster@4.1-service-qti
    class hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /system/lib:/vendor/lib
    seclabel u:r:recovery:s0
    disabled

# 万一 ROM 只用 keymaster 4.0 接口
service vendor.keymaster-4-0-qti /system/bin/android.hardware.keymaster@4.0-service-qti
    class hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /system/lib:/vendor/lib
    seclabel u:r:recovery:s0
    disabled

# gatekeeper：FBE v2 校验用户凭证（图案/密码）
service vendor.gatekeeper-1-0-qti /system/bin/android.hardware.gatekeeper@1.0-service-qti
    class hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /system/lib:/vendor/lib
    seclabel u:r:recovery:s0
    disabled

# FBE：解密完成、进入 /data 前需要 keyring
on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring
